# Текст по умолчанию использует LF во избежание межплатформенных различий переводов строк
* text eol=lf

# Пакетные файлы Windows / PowerShell сохраняют CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Для распространённых скриптов и конфигов принудительно LF
*.sh text eol=lf
*.py text eol=lf
*.pyw text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Для бинарных файлов преобразование концов строк не выполняется
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.icns binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.p12 binary
*.pfx binary
*.cer binary
*.der binary
*.db binary
*.zip binary
*.gz binary
*.bz2 binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
